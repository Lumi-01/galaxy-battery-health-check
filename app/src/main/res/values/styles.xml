<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#73EBC3</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowBackground">#0C131C</item>
        <item name="android:statusBarColor">#0C131C</item>
        <item name="android:navigationBarColor">#0C131C</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="AppTheme.Light" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#007458</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowBackground">#F3F5F8</item>
        <item name="android:statusBarColor">#F3F5F8</item>
        <item name="android:navigationBarColor">#F3F5F8</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
</resources>
